%============================================================================%
%  academic-cv.sty --- Bilingual (EN/ZH) academic CV style layer
%----------------------------------------------------------------------------%
%  Part of the Academic Visiting-Scholar CV LaTeX template.
%  Contains all visual definitions: packages, fonts, icons, colors,
%  page layout and CV commands. Compile with XeLaTeX (run twice).
%
%  Do NOT edit this file unless you want to change the template itself.
%  Personal content lives in cv-content-en.tex / cv-content-zh.tex.
%============================================================================%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic-cv}[2026/08/13 v1.0 Bilingual academic CV style]

%----------------------------------------------------------------------------%
%  PACKAGES
%----------------------------------------------------------------------------%
\RequirePackage{fontspec}                      % font loading (XeLaTeX)
\RequirePackage{xeCJK}                         % Chinese typesetting
\RequirePackage{xstring, xifthen}              % \isempty test
\RequirePackage{enumitem}                      % list customization
\RequirePackage[english]{babel}                % english hyphenation
\RequirePackage[USenglish]{isodate}            % date style for \today
\RequirePackage{fancyhdr}                      % empty page style
\RequirePackage{paracol}                       % breakable two-column layout
\RequirePackage{tikzpagenodes}                 % current page text area nodes
\usetikzlibrary{calc}
\RequirePackage{atbegshi}                      % per-page shipout hooks
\RequirePackage[a4paper]{geometry}             % page geometry
\RequirePackage{array}                         % extended tabular columns
\RequirePackage{graphicx}                      % photos and images
\RequirePackage{tikz}                          % drawing (header band, bars)
\usetikzlibrary{shapes, backgrounds, mindmap, trees}
\RequirePackage{xcolor}                        % colors
\RequirePackage{transparent}                   % transparency helpers

%----------------------------------------------------------------------------%
%  FONTS
%  English: Raleway (TeX Live) -- Latin default
%  Chinese: PingFang SC on macOS, Fandol Hei elsewhere (TeX Live bundle)
%----------------------------------------------------------------------------%
\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
\setmainfont{Raleway-Regular.otf}[
  BoldFont=Raleway-Bold.otf,
  ItalicFont=Raleway-RegularItalic.otf,
  BoldItalicFont=Raleway-BoldItalic.otf
]
\setsansfont{Raleway-Regular.otf}[
  BoldFont=Raleway-Bold.otf,
  ItalicFont=Raleway-RegularItalic.otf,
  BoldItalicFont=Raleway-BoldItalic.otf
]
\renewcommand*\familydefault{\sfdefault}

\IfFontExistsTF{PingFang SC}{%
  \setCJKmainfont{PingFang SC}
  \setCJKsansfont{PingFang SC}
}{%
  \setCJKmainfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]
  \setCJKsansfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]
}

%----------------------------------------------------------------------------%
%  ICONS  -- Font Awesome v4 loaded as an OpenType font via fontspec
%  (add more icons by picking their Unicode codepoint from FA 4.7)
%----------------------------------------------------------------------------%
\newfontfamily{\iconfont}{FontAwesome.otf}
\newcommand{\faCaretRight}{{\iconfont\char"F0DA}}
\newcommand{\faMapMarker}{{\iconfont\char"F041}}
\newcommand{\faMobilePhone}{{\iconfont\char"F10B}}
\newcommand{\faPhone}{{\iconfont\char"F095}}
\newcommand{\faEnvelope}{{\iconfont\char"F0E0}}
\newcommand{\faGithub}{{\iconfont\char"F09B}}

%----------------------------------------------------------------------------%
%  GLOBAL COLOR PALETTE --- edit this block to re-theme the whole CV
%----------------------------------------------------------------------------%
% maincol  -- body text (soft slate)
\definecolor{maincol}{RGB}{52,62,80}

% darkcol  -- section headings (deep navy)
\definecolor{darkcol}{RGB}{24,44,82}

% accentcol -- header band, date boxes, rules, progress bars (American blue)
\definecolor{accentcol}{RGB}{59,89,152}

% lightcol -- footer band, progress-bar track (soft blue-grey)
\definecolor{lightcol}{RGB}{238,242,247}

%----------------------------------------------------------------------------%
%  PAGE LAYOUT
%----------------------------------------------------------------------------%
% tight margins, no page numbers by default
\geometry{top=1cm, bottom=1cm, left=1cm, right=1cm}
\pagestyle{empty}
\setlength{\parindent}{0mm}

% flexible line breaking in narrow sidebar columns
\emergencystretch=1.5em

% minipage width minus two times \fboxsep (keeps padding inside width)
\newcommand{\mpwidth}{\linewidth-\fboxsep-\fboxsep}

%----------------------------------------------------------------------------%
%  HYPERLINKS -- load last
%----------------------------------------------------------------------------%
\RequirePackage[hidelinks]{hyperref}

%----------------------------------------------------------------------------%
%  ICON COMMANDS
%----------------------------------------------------------------------------%
% vertically center any content
\newcommand*{\vcenteredhbox}[1]{\begingroup
\setbox0=\hbox{#1}\parbox{\wd0}{\box0}\endgroup}

% icon glyph in a fixed-size box, colored with the main text color
\newcommand{\icon}[2]{
	\makebox(#2, #2){\textcolor{maincol}{\csname fa#1\endcsname}}
}

% icon + adjacent text
\newcommand{\icontext}[3]{
	\vcenteredhbox{\icon{#1}{#2}}  \hspace{2pt}
	\parbox{0.9\mpwidth}{\raggedright\textcolor{black}{#3}}
}

% icon + external URL link
\newcommand{\iconhref}[4]{
	\vcenteredhbox{\icon{#1}{#2}}  \hspace{2pt}
	\href{#4}{\textcolor{black}{#3}}
}

% icon + email link
\newcommand{\iconemail}[4]{
	\vcenteredhbox{\icon{#1}{#2}}  \hspace{2pt}
	\href{mailto:#4}{\textcolor{black}{#3}}
}

%----------------------------------------------------------------------------%
%  CV TEXT -- paragraph-style text block
%----------------------------------------------------------------------------%
\newcommand{\cvtext}[1]{
	\begin{tabular*}{1\mpwidth}{@{}p{1\mpwidth}@{}}
		\parbox{0.985\mpwidth}{#1}
	\end{tabular*}
}

%----------------------------------------------------------------------------%
%  CV LIST -- bullet list for achievements / compact info
%----------------------------------------------------------------------------%
\newcommand{\cvlist}[1]{
	\begin{itemize}{#1}\end{itemize}
}

%----------------------------------------------------------------------------%
%  CV SECTION -- section headline with a full-width accent underline
%----------------------------------------------------------------------------%
\newcommand{\cvsection}[1]{
	\vspace{7pt}
	\cvtext{
		\textbf{\LARGE{\textcolor{darkcol}{#1}}}\\[-4pt]
		\textcolor{accentcol}{ \rule{\linewidth}{1.5pt} } \\
	}
}

%----------------------------------------------------------------------------%
%  CV SKILL -- skill name + level on one line, full-width progress bar below
%  usage: \cvskill{Name}{Level}{percent 0--1}
%----------------------------------------------------------------------------%
\newcommand{\cvskill}[3]{
	\textcolor{black}{\textbf{#1}} \hfill \textcolor{maincol}{#2}\\[-1pt]
	\begin{tikzpicture}[scale=1,rounded corners=2pt,very thin]
		\fill [lightcol] (0,0) rectangle (1\mpwidth, 0.15);
		\fill [accentcol] (0,0) rectangle (#3\mpwidth, 0.15);
  	\end{tikzpicture}\\[3pt]
}

%----------------------------------------------------------------------------%
%  CV EVENT -- time box + title + affiliation + description
%  usage: \cvevent{Time}{Title}{Affiliation}{Description}
%----------------------------------------------------------------------------%
\newcommand{\cvevent}[4]{
	% parbox keeps title and description together across page breaks
	\parbox{\mpwidth}{
		\begin{tabular*}{1\mpwidth}{@{}p{\dimexpr 0.66\mpwidth-4pt\relax}@{\hspace{4pt}}r@{}}
			\textcolor{black}{\textbf{#2}} & \colorbox{accentcol}{\makebox[0.34\mpwidth]{\textcolor{white}{\textbf{#1}}}} \\
			\textcolor{maincol}{#3} & \\
		\end{tabular*}\\[4pt]
		\ifthenelse{\isempty{#4}}{}{
			\cvtext{#4}\\
		}
	}
	\vspace{5pt}
}

%----------------------------------------------------------------------------%
%  CV META EVENT -- sidebar entry (time / title / place / note)
%  usage: \cvmetaevent{Time}{Title}{Place}{Note}
%----------------------------------------------------------------------------%
\newcommand{\cvmetaevent}[4]{
	\textcolor{maincol}{ \cvtext{\textbf{\begin{flushleft}#1\end{flushleft}}}}
	\ifthenelse{\isempty{#2}}{}{
		\textcolor{black}{\cvtext{\textbf{#2}}}
	}
	\ifthenelse{\isempty{#3}}{}{
		\cvtext{{ \textcolor{maincol}{#3} }}\\
	}
	\cvtext{#4}\\[5pt]
}

%----------------------------------------------------------------------------%
%  HEADER & FOOTER -- accent band on top, light band at the bottom
%----------------------------------------------------------------------------%
\newcommand\Header[1]{%
\begin{tikzpicture}[remember picture,overlay]
\fill[accentcol]
  (current page.north west) -- (current page.north east) --
  ([yshift=50pt]current page.north east|-current page text area.north east) --
  ([yshift=50pt,xshift=-3cm]current page.north|-current page text area.north) --
  ([yshift=10pt,xshift=-5cm]current page.north|-current page text area.north) --
  ([yshift=10pt]current page.north west|-current page text area.north west) -- cycle;
\node[font=\sffamily\bfseries\color{white},anchor=west,
  xshift=0.7cm,yshift=-0.32cm] at (current page.north west)
  {\fontsize{12}{12}\selectfont {#1}};
\end{tikzpicture}%
}

\newcommand\Footer[1]{%
\begin{tikzpicture}[remember picture,overlay]
\fill[lightcol]
  (current page.south east) -- (current page.south west) --
  ([yshift=-80pt]current page.south east|-current page text area.south east) --
  ([yshift=-80pt,xshift=-6cm]current page.south|-current page text area.south) --
  ([xshift=-2.5cm,yshift=-10pt]current page.south|-current page text area.south) --
  ([yshift=-10pt]current page.south east|-current page text area.south east) -- cycle;
\node[yshift=0.32cm,xshift=9cm] at (current page.south) {\fontsize{10}{10}\selectfont \textbf{\thepage}};
\end{tikzpicture}%
}

%----------------------------------------------------------------------------%
%  DOCUMENT HEADER/FOOTER HOOKS -- applied automatically on every page
%  The name shown in the top band is set per language in the content file
%  via \cvheadername.
%----------------------------------------------------------------------------%
\newcommand{\cvheadername}{Lin Wei}   % default; override in cv-content-*.tex
\AtBeginShipout{\AtBeginShipoutAddToBox{\Header{\cvheadername}\Footer{\thepage}}}

\endinput
